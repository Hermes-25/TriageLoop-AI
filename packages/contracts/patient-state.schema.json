{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triageloop.local/contracts/patient-state.schema.json",
  "title": "TriageLoop Patient State",
  "description": "Versioned prototype contract for patient intake, longitudinal observations and current clinician-assigned state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patient_id",
    "arrival_time",
    "age_years",
    "sex_at_birth",
    "chief_complaint",
    "history_status",
    "observations",
    "clinician_state",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "patient_id": {
      "type": "string",
      "pattern": "^P-[0-9]{3,6}$"
    },
    "arrival_time": {
      "type": "string",
      "format": "date-time"
    },
    "age_years": {
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "sex_at_birth": {
      "type": "string",
      "enum": ["female", "male", "intersex", "unknown"]
    },
    "pregnancy_status": {
      "type": ["string", "null"],
      "enum": ["pregnant", "not_pregnant", "unknown", "not_applicable", null]
    },
    "chief_complaint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "reported_symptoms": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "uniqueItems": true
    },
    "observed_cues": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "uniqueItems": true
    },
    "history_status": {
      "type": "string",
      "enum": ["available", "partial", "none"]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "uniqueItems": true
        },
        "medications": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "uniqueItems": true
        },
        "allergies": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "uniqueItems": true
        },
        "frailty_score": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    },
    "clinician_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assigned_level", "status"],
      "properties": {
        "assigned_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "reassessment_due", "escalated", "in_care", "completed"]
        },
        "assigned_by_role": {
          "type": "string",
          "enum": ["nurse", "charge_nurse", "clinician", "system_fixture"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "synthetic"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["manual", "csv", "fhir_like", "synthetic_generator", "scripted_fixture"]
        },
        "synthetic": { "const": true },
        "generator_version": { "type": ["string", "null"] },
        "scenario_id": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "recorded_at", "source", "values"],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": ["triage", "reassessment", "monitor", "manual_correction", "synthetic_event"]
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heart_rate_bpm": { "type": ["number", "null"] },
            "respiratory_rate_per_min": { "type": ["number", "null"] },
            "spo2_percent": { "type": ["number", "null"] },
            "systolic_bp_mmhg": { "type": ["number", "null"] },
            "diastolic_bp_mmhg": { "type": ["number", "null"] },
            "temperature_c": { "type": ["number", "null"] },
            "gcs": { "type": ["number", "null"], "minimum": 3, "maximum": 15 },
            "pain_score_0_10": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "mental_status": {
              "type": ["string", "null"],
              "enum": ["alert", "voice", "pain", "unresponsive", "confused", "unknown", null]
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
            "reliability": { "type": "number", "minimum": 0, "maximum": 1 },
            "flags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["missing", "stale", "implausible", "corrected", "device_warning", "self_reported"]
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}

